    </header>

    <!-- 1. ГЛАВНАЯ (HERO-БЛОК) -->
    <section id="hero" class="pt-28 pb-16 sm:pt-36 sm:pb-24 bg-gradient-to-b from-brand-50/80 via-white to-slate-50 border-b border-slate-200/60 overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="max-w-4xl mx-auto text-center">
                <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border border-brand-200 shadow-sm text-brand-700 text-xs sm:text-sm font-medium mb-6">
                    <span class="flex h-2 w-2 rounded-full bg-brand-600 animate-pulse"></span>
                    Индивидуальный исследовательский проект • 10 класс
                </div>
                
                <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 tracking-tight leading-[1.15] mb-6">
                    <span class="bg-clip-text text-transparent bg-gradient-to-r from-brand-600 to-indigoAccent-600">«ЕГЭ-Навигатор»</span> — твой путеводитель по рациональной подготовке к ЕГЭ
                </h1>
                
                <p class="text-base sm:text-xl text-slate-600 leading-relaxed max-w-3xl mx-auto mb-9">
                    Как не переплачивать десятки тысяч рублей за репетиторов и курсы, используя официальные базы <strong>ФИПИ</strong>, тренажёр <strong>«Решу ЕГЭ»</strong> и точечное обучение только по самым сложным темам.
                </p>

                <!-- Кнопки действий -->
                <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-14">
                    <a href="#methodology" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-2xl bg-brand-600 hover:bg-brand-700 text-white font-semibold shadow-lg shadow-brand-600/25 transition-all hover:-translate-y-0.5">
                        <i data-lucide="calendar-check" class="w-5 h-5"></i>
                        Перейти к плану подготовки
                    </a>
                    <a href="#survey" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-2xl bg-white hover:bg-slate-50 text-slate-800 font-semibold border border-slate-200 shadow-sm transition-all hover:-translate-y-0.5">
                        <i data-lucide="clipboard-list" class="w-5 h-5 text-indigoAccent-600"></i>
                        Пройти опрос
